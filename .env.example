# Database connection settings read by app/config.py.
# Copy the lines you need into your shell (export DB_NAME=...) - the
# programs read ENVIRONMENT VARIABLES; they do not load this file.
# Leave a value unset to use the default shown.

# Database name (default: stock_watchlist)
DB_NAME=stock_watchlist

# Host (default: unset = local Unix socket, which the Homebrew server uses)
# DB_HOST=localhost

# Port (default: unset = 5432)
# DB_PORT=5432

# User (default: unset = your macOS login name)
# DB_USER=

# Password: the local Homebrew server uses trust authentication, so none is
# needed. If a password is ever required, use libpq's standard PGPASSWORD
# variable or a ~/.pgpass file - never put a real password in this file.
