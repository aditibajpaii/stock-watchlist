 alert_rules  | trg_alert_rules_instrument_immutable | CREATE TRIGGER trg_alert_rules_instrument_immutable BEFORE UPDATE OF instrument_id ON public.alert_rules FOR EACH ROW EXECUTE FUNCTION forbid_instrument_change()
