===== A1. Defaults: both timestamps come from now() = start time of the current transaction =====
SELECT table_name, column_name, column_default, is_nullable
FROM information_schema.columns
WHERE table_schema = 'public' AND column_name IN ('fired_at', 'ingested_at')
ORDER BY table_name;
  table_name  | column_name | column_default | is_nullable 
--------------+-------------+----------------+-------------
 alert_events | fired_at    | now()          | NO
 price_ticks  | ingested_at | now()          | NO
(2 rows)

===== A2. Every line of the alert trigger function that mentions alert_events or fired_at =====
SELECT n AS line, btrim(l) AS text
FROM regexp_split_to_table(pg_get_functiondef('public.evaluate_price_alerts()'::regprocedure), E'\n')
     WITH ORDINALITY AS f(l, n)
WHERE l ~* 'alert_events|fired_at'
ORDER BY n;
 line |                              text                              
------+----------------------------------------------------------------
   49 | --    this rule's most recent event (not fired_at).
   51 | FROM alert_events e
   64 | INSERT INTO alert_events (rule_id, tick_id)
   66 | ON CONFLICT ON CONSTRAINT uq_alert_events_rule_tick DO NOTHING
   71 | PERFORM pg_notify('alert_events', v_event_id::TEXT);
(5 rows)

===== A3. Triggers on alert_events: none fires on a change of fired_at =====
SELECT t.tgname, pg_get_triggerdef(t.oid) AS definition
FROM pg_trigger t
WHERE t.tgrelid = 'public.alert_events'::regclass AND NOT t.tgisinternal;
              tgname               |                                                                                    definition                                                                                    
-----------------------------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 trg_alert_events_check_instrument | CREATE TRIGGER trg_alert_events_check_instrument BEFORE INSERT OR UPDATE OF rule_id, tick_id ON public.alert_events FOR EACH ROW EXECUTE FUNCTION check_alert_event_instrument()
(1 row)

===== A4. Roles that may write alert_events directly in this database =====
SELECT r.rolname, r.rolsuper, r.rolcanlogin,
       has_table_privilege(r.rolname, 'public.alert_events', 'INSERT') AS can_insert,
       has_table_privilege(r.rolname, 'public.alert_events', 'UPDATE') AS can_update
FROM pg_roles r
WHERE r.rolname = current_user OR r.rolname LIKE 'r2\_%'
ORDER BY r.rolsuper DESC, r.rolname;
  rolname   | rolsuper | rolcanlogin | can_insert | can_update 
------------+----------+-------------+------------+------------
 aditi      | t        | t           | t          | t
 r2_analyst | f        | f           | f          | f
 r2_feed    | f        | f           | f          | f
 r2_owner   | f        | f           | t          | f
 r2_support | f        | f           | f          | f
(5 rows)

BEGIN;
SELECT max(observed_at) + interval '5 minutes' AS t_rel FROM price_ticks WHERE instrument_id = 1 
SELECT max(observed_at) + interval '5 minutes' AS t_tcs FROM price_ticks WHERE instrument_id = 2 
===== B1. Application path: ONE tick that fires TWO rules =====
temporary second rule: priya, RELIANCE ABOVE 3005 (rolled back at the end)
INSERT INTO alert_rules (user_id, instrument_id, direction, threshold, cooldown_seconds)
SELECT user_id, 1, 'ABOVE', 3005, 0 FROM users WHERE username = 'priya'
RETURNING rule_id, direction, threshold;
 rule_id | direction |   threshold   
---------+-----------+---------------
       9 | ABOVE     | 3005.00000000
(1 row)

RELIANCE 2788 -> 3010 crosses ABOVE 3000 (arjun) and ABOVE 3005 (priya):
SELECT * FROM ingest_tick('NSE', 'RELIANCE', '2026-10-13 10:16:16+05:30'::timestamptz, 3010.00, 100, 'MANUAL', 'r2-fired-1');
  status  | tick_id 
----------+---------
 INSERTED |      38
(1 row)

SELECT e.event_id, e.rule_id, e.tick_id, e.fired_at, t.ingested_at,
       e.fired_at = t.ingested_at AS fired_at_equals_ingested_at
FROM alert_events e JOIN price_ticks t ON t.tick_id = e.tick_id
WHERE t.source_event_id = 'r2-fired-1'
ORDER BY e.event_id;
 event_id | rule_id | tick_id |             fired_at             |           ingested_at            | fired_at_equals_ingested_at 
----------+---------+---------+----------------------------------+----------------------------------+-----------------------------
       14 |       1 |      38 | 2026-10-13 10:03:37.410179+05:30 | 2026-10-13 10:03:37.410179+05:30 | t
       15 |       9 |      38 | 2026-10-13 10:03:37.410179+05:30 | 2026-10-13 10:03:37.410179+05:30 | t
(2 rows)

===== B2. Application path: a second tick (TCS) ingested in the SAME transaction =====
SELECT * FROM ingest_tick('NSE', 'TCS', '2026-10-13 10:10:46+05:30'::timestamptz, 3510.00, 100, 'MANUAL', 'r2-fired-2');
  status  | tick_id 
----------+---------
 INSERTED |      39
(1 row)

SELECT * FROM ingest_tick('NSE', 'TCS', '2026-10-13 10:10:46+05:30'::timestamptz + interval '1 second', 3480.00, 100, 'MANUAL', 'r2-fired-3');
  status  | tick_id 
----------+---------
 INSERTED |      40
(1 row)

events created in this transaction: different ticks, yet one shared fired_at (transaction start time)
SELECT e.event_id, e.rule_id, e.tick_id, t.source_event_id, e.fired_at
FROM alert_events e JOIN price_ticks t ON t.tick_id = e.tick_id
WHERE t.source_event_id LIKE 'r2-fired-%'
ORDER BY e.event_id;
 event_id | rule_id | tick_id | source_event_id |             fired_at             
----------+---------+---------+-----------------+----------------------------------
       14 |       1 |      38 | r2-fired-1      | 2026-10-13 10:03:37.410179+05:30
       15 |       9 |      38 | r2-fired-1      | 2026-10-13 10:03:37.410179+05:30
       16 |       4 |      40 | r2-fired-3      | 2026-10-13 10:03:37.410179+05:30
(3 rows)

SELECT count(DISTINCT e.tick_id) AS ticks, count(DISTINCT e.fired_at) AS distinct_fired_at
FROM alert_events e JOIN price_ticks t ON t.tick_id = e.tick_id
WHERE t.source_event_id LIKE 'r2-fired-%';
 ticks | distinct_fired_at 
-------+-------------------
     2 |                 1
(1 row)

===== B3. On everything the application path produced so far: ticks with more than one fired_at (expect 0) =====
SELECT count(*) AS ticks_with_several_fired_at
FROM (SELECT tick_id FROM alert_events GROUP BY tick_id HAVING count(DISTINCT fired_at) > 1) AS x;
 ticks_with_several_fired_at 
-----------------------------
                           0
(1 row)

===== C1. Accepted by the schema: a hand-written event for tick 6 with an explicit fired_at =====
INSERT INTO alert_events (rule_id, tick_id, fired_at)
VALUES (2, 6, '2026-01-01 09:15:00+05:30')
RETURNING event_id, rule_id, tick_id, fired_at;
 event_id | rule_id | tick_id |         fired_at          
----------+---------+---------+---------------------------
       17 |       2 |       6 | 2026-01-01 09:15:00+05:30
(1 row)

SELECT e.event_id, e.rule_id, e.tick_id, e.fired_at
FROM alert_events e WHERE e.tick_id = 6 ORDER BY e.event_id;
 event_id | rule_id | tick_id |             fired_at             
----------+---------+---------+----------------------------------
        1 |       1 |       6 | 2026-10-13 10:03:36.426811+05:30
       17 |       2 |       6 | 2026-01-01 09:15:00+05:30
(2 rows)

===== C2. Accepted by the schema: UPDATE of fired_at (no trigger or CHECK watches it) =====
UPDATE alert_events SET fired_at = fired_at + interval '1 hour' WHERE event_id = 1
RETURNING event_id, tick_id, fired_at;
 event_id | tick_id |             fired_at             
----------+---------+----------------------------------
        1 |       6 | 2026-10-13 11:03:36.426811+05:30
(1 row)

===== C3. Now the dependency tick_id -> fired_at is broken in a state the schema accepted =====
SELECT tick_id, count(*) AS events, count(DISTINCT fired_at) AS distinct_fired_at
FROM alert_events
GROUP BY tick_id
HAVING count(DISTINCT fired_at) > 1
ORDER BY tick_id;
 tick_id | events | distinct_fired_at 
---------+--------+-------------------
       6 |      2 |                 2
(1 row)

ROLLBACK;
===== After ROLLBACK: the committed replay data again satisfy fired_at = ingested_at =====
SELECT count(*) AS alert_events,
       count(*) FILTER (WHERE e.fired_at = t.ingested_at) AS fired_at_equals_ingested_at
FROM alert_events e JOIN price_ticks t ON t.tick_id = e.tick_id;
 alert_events | fired_at_equals_ingested_at 
--------------+-----------------------------
            8 |                           8
(1 row)

