=== W01 | LAG | How did the RELIANCE price change from each tick to the next?
SELECT t.tick_id, t.price,
       lag(t.price) OVER w                                AS previous_price,
       t.price - lag(t.price) OVER w                      AS change,
       round(100 * (t.price - lag(t.price) OVER w)
                 / lag(t.price) OVER w, 3)                AS change_pct
FROM price_ticks t
WHERE t.instrument_id = 1              -- NSE RELIANCE
WINDOW w AS (ORDER BY t.observed_at, t.tick_id)
ORDER BY t.observed_at, t.tick_id;
 tick_id |     price     | previous_price |    change     | change_pct 
---------+---------------+----------------+---------------+------------
       1 | 2985.50000000 |         (null) |        (null) |     (null)
       4 | 2994.00000000 |  2985.50000000 |    8.50000000 |      0.285
       6 | 3002.40000000 |  2994.00000000 |    8.40000000 |      0.281
       8 | 3011.00000000 |  3002.40000000 |    8.60000000 |      0.286
      11 | 3018.75000000 |  3011.00000000 |    7.75000000 |      0.257
      17 | 2979.00000000 |  3018.75000000 |  -39.75000000 |     -1.317
      23 | 3004.00000000 |  2979.00000000 |   25.00000000 |      0.839
