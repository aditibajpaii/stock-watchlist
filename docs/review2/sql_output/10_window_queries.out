=== W04 | LEAD | How many seconds of market time pass before the next BTCUSDT tick?
SELECT t.tick_id, t.price,
       lead(t.price) OVER w                                             AS next_price,
       extract(epoch FROM lead(t.observed_at) OVER w - t.observed_at)::int AS seconds_to_next_tick
FROM price_ticks t
WHERE t.instrument_id = 6              -- BINANCE BTCUSDT
WINDOW w AS (ORDER BY t.observed_at, t.tick_id)
ORDER BY t.observed_at, t.tick_id;
 tick_id |      price      |   next_price    | seconds_to_next_tick 
---------+-----------------+-----------------+----------------------
       3 |  99450.00000000 |  99880.00000000 |                   20
       7 |  99880.00000000 | 100120.00000000 |                   15
      10 | 100120.00000000 | 100310.00000000 |                   20
      14 | 100310.00000000 |  99920.00000000 |                   10
      15 |  99920.00000000 | 100050.00000000 |                   10
      16 | 100050.00000000 |  99800.00000000 |                   70
      21 |  99800.00000000 | 100400.00000000 |                   20
      22 | 100400.00000000 |          (null) |               (null)
(8 rows)

=== W05 | moving average | What is the 3-tick moving average of the TCS price?
SELECT t.tick_id, t.price,
       round(avg(t.price) OVER (ORDER BY t.observed_at, t.tick_id
                                ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 2) AS moving_avg_3
FROM price_ticks t
WHERE t.instrument_id = 2              -- NSE TCS
ORDER BY t.observed_at, t.tick_id;
