=== N1 | fired_at equals the ingested_at of the firing tick for every event?
SELECT count(*)                                                   AS alert_events,
       count(*) FILTER (WHERE e.fired_at = t.ingested_at)         AS fired_at_equals_tick_ingested_at,
       count(*) FILTER (WHERE e.fired_at IS DISTINCT FROM t.ingested_at) AS different
FROM alert_events e
JOIN price_ticks t ON t.tick_id = e.tick_id;
 alert_events | fired_at_equals_tick_ingested_at | different 
--------------+----------------------------------+-----------
            8 |                                8 |         0
(1 row)

=== N2 | Unnormalized: one row per user with two repeating groups (watchlist entries, rules)
SELECT u.username, u.email,
       (SELECT string_agg(w.name || ': ' || i.symbol, '; ' ORDER BY w.name, i.symbol)
          FROM watchlists w
          JOIN watchlist_items wi ON wi.watchlist_id = w.watchlist_id
          JOIN instruments i      ON i.instrument_id = wi.instrument_id
         WHERE w.user_id = u.user_id)                         AS watchlist_entries,
       (SELECT string_agg(i.symbol || ' ' || r.direction || ' ' || round(r.threshold)
                          || ' cd ' || r.cooldown_seconds, '; ' ORDER BY r.rule_id)
          FROM alert_rules r
          JOIN instruments i ON i.instrument_id = r.instrument_id
         WHERE r.user_id = u.user_id)                         AS alert_rules
FROM users u
ORDER BY u.username;
 username |       email       |                                     watchlist_entries                                      |                                    alert_rules                                     
----------+-------------------+--------------------------------------------------------------------------------------------+------------------------------------------------------------------------------------
 arjun    | arjun@example.com | Crypto: BTCUSDT; Crypto: ETHUSDT; Long Term: HDFCBANK; Long Term: RELIANCE; Long Term: TCS | RELIANCE ABOVE 3000 cd 300; RELIANCE BELOW 2800 cd 300; BTCUSDT ABOVE 100000 cd 60
 kavya    | kavya@example.com | Main: BTCUSDT; Main: INFY; Main: RELIANCE                                                  | ETHUSDT BELOW 3000 cd 120
 priya    | priya@example.com | Auto: M&M; Tech: INFY; Tech: TCS                                                           | TCS BELOW 3500 cd 0; INFY ABOVE 1600 cd 600
(3 rows)

=== N3 | 1NF relation WATCH_ENTRY(username, watchlist_name, exchange, symbol, instrument_name, quote_currency)
SELECT u.username, w.name AS watchlist_name, i.exchange, i.symbol,
       i.name AS instrument_name, i.quote_currency
FROM watchlists w
JOIN users u            ON u.user_id = w.user_id
JOIN watchlist_items wi ON wi.watchlist_id = w.watchlist_id
JOIN instruments i      ON i.instrument_id = wi.instrument_id
ORDER BY i.symbol, u.username, w.name;
