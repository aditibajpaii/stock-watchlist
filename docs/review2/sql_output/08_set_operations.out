=== SET01 | UNION | Which instruments is each user interested in (watched OR alerted), without duplicates?
SELECT u.username, i.symbol
FROM watchlists w
JOIN watchlist_items wi ON wi.watchlist_id = w.watchlist_id
JOIN users u            ON u.user_id = w.user_id
JOIN instruments i      ON i.instrument_id = wi.instrument_id
UNION
SELECT u.username, i.symbol
FROM alert_rules r
JOIN users u       ON u.user_id = r.user_id
JOIN instruments i ON i.instrument_id = r.instrument_id
ORDER BY username, symbol;
 username |  symbol  
----------+----------
 arjun    | BTCUSDT
 arjun    | ETHUSDT
 arjun    | HDFCBANK
 arjun    | RELIANCE
 arjun    | TCS
 kavya    | BTCUSDT
 kavya    | ETHUSDT
 kavya    | INFY
 kavya    | RELIANCE
 priya    | INFY
 priya    | M&M
 priya    | TCS
(12 rows)

=== SET02 | UNION ALL | Show one RELIANCE timeline of every tick and every alert, in market-time order
SELECT t.observed_at AS market_time, 1 AS seq, 'tick' AS kind,
       t.price AS price, NULL AS detail
FROM price_ticks t
WHERE t.instrument_id = 1              -- NSE RELIANCE
UNION ALL
SELECT t.observed_at, 2, 'ALERT', t.price,
       u.username || ' ' || r.direction || ' ' || round(r.threshold, 2)
FROM alert_events e
JOIN alert_rules r ON r.rule_id = e.rule_id
JOIN users u       ON u.user_id = r.user_id
JOIN price_ticks t ON t.tick_id = e.tick_id
WHERE t.instrument_id = 1
ORDER BY market_time, seq;
        market_time        | seq | kind  |     price     |       detail        
---------------------------+-----+-------+---------------+---------------------
 2026-10-13 10:03:36+05:30 |   1 | tick  | 2985.50000000 | (null)
 2026-10-13 10:03:46+05:30 |   1 | tick  | 2994.00000000 | (null)
 2026-10-13 10:03:56+05:30 |   1 | tick  | 3002.40000000 | (null)
 2026-10-13 10:03:56+05:30 |   2 | ALERT | 3002.40000000 | arjun ABOVE 3000.00
 2026-10-13 10:04:06+05:30 |   1 | tick  | 3011.00000000 | (null)
