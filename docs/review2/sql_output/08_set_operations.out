=== SET03 | INTERSECT | Which (user, instrument) pairs are both watched AND covered by an alert rule?
SELECT u.username, i.symbol
FROM watchlists w
JOIN watchlist_items wi ON wi.watchlist_id = w.watchlist_id
JOIN users u            ON u.user_id = w.user_id
JOIN instruments i      ON i.instrument_id = wi.instrument_id
INTERSECT
SELECT u.username, i.symbol
FROM alert_rules r
JOIN users u       ON u.user_id = r.user_id
JOIN instruments i ON i.instrument_id = r.instrument_id
ORDER BY username, symbol;
 username |  symbol  
----------+----------
 arjun    | BTCUSDT
 arjun    | RELIANCE
 priya    | INFY
 priya    | TCS
(4 rows)

=== SET04 | EXCEPT | Which instruments does each user watch but has no alert rule for?
SELECT u.username, i.symbol
FROM watchlists w
JOIN watchlist_items wi ON wi.watchlist_id = w.watchlist_id
JOIN users u            ON u.user_id = w.user_id
JOIN instruments i      ON i.instrument_id = wi.instrument_id
EXCEPT
SELECT u.username, i.symbol
FROM alert_rules r
JOIN users u       ON u.user_id = r.user_id
JOIN instruments i ON i.instrument_id = r.instrument_id
ORDER BY username, symbol;
 username |  symbol  
----------+----------
 arjun    | ETHUSDT
 arjun    | HDFCBANK
 arjun    | TCS
 kavya    | BTCUSDT
 kavya    | INFY
 kavya    | RELIANCE
 priya    | M&M
(7 rows)

=== SET05 | EXCEPT | Which alert rules are on instruments the user does not watch (the reverse difference)?
SELECT u.username, i.symbol
FROM alert_rules r
JOIN users u       ON u.user_id = r.user_id
JOIN instruments i ON i.instrument_id = r.instrument_id
EXCEPT
SELECT u.username, i.symbol
FROM watchlists w
JOIN watchlist_items wi ON wi.watchlist_id = w.watchlist_id
JOIN users u            ON u.user_id = w.user_id
JOIN instruments i      ON i.instrument_id = wi.instrument_id
ORDER BY username, symbol;
 username | symbol  
----------+---------
 kavya    | ETHUSDT
(1 row)

