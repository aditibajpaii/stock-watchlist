===== Triggers on the three tables involved (catalog) =====
SELECT c.relname AS table_name, t.tgname, pg_get_triggerdef(t.oid) AS definition
FROM pg_trigger t
JOIN pg_class c ON c.oid = t.tgrelid
WHERE NOT t.tgisinternal AND c.relname IN ('alert_events', 'alert_rules', 'price_ticks')
ORDER BY c.relname;
  table_name  |              tgname               |                                                                                    definition                                                                                    
--------------+-----------------------------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 alert_events | trg_alert_events_check_instrument | CREATE TRIGGER trg_alert_events_check_instrument BEFORE INSERT OR UPDATE OF rule_id, tick_id ON public.alert_events FOR EACH ROW EXECUTE FUNCTION check_alert_event_instrument()
 price_ticks  | trg_price_ticks_evaluate_alerts   | CREATE TRIGGER trg_price_ticks_evaluate_alerts AFTER INSERT ON public.price_ticks FOR EACH ROW EXECUTE FUNCTION evaluate_price_alerts()
(2 rows)

BEGIN;
CREATE TEMP VIEW mismatched_events AS
SELECT e.event_id, e.rule_id, r.instrument_id AS rule_instrument,
       e.tick_id, t.instrument_id AS tick_instrument
FROM alert_events e
JOIN alert_rules r ON r.rule_id = e.rule_id
JOIN price_ticks t ON t.tick_id = e.tick_id
WHERE r.instrument_id <> t.instrument_id;
events whose rule and tick refer to different instruments, before (expect 0):
SELECT count(*) AS mismatched FROM mismatched_events;
 mismatched 
------------
          0
(1 row)

SAVEPOINT start;
===== 1. Through alert_events: the trigger rejects the breach =====
>>> EXPECTED ERROR [23514] move event 1 (rule 1 = RELIANCE) onto tick 2 (TCS)
UPDATE alert_events SET tick_id = 2 WHERE event_id = 1;
psql:sql/review2/22_integrity_scope.sql:33: ERROR:  alert_events: rule 1 is for instrument 1, but tick 2 is for instrument 2
HINT:  An alert event must pair a rule and a price tick of the same instrument.
CONTEXT:  PL/pgSQL function check_alert_event_instrument() line 16 at RAISE
<<< actual SQLSTATE: 23514
ROLLBACK TO SAVEPOINT start;
===== 2. Through the PARENT alert_rules: UPDATE of instrument_id is accepted =====
UPDATE alert_rules SET instrument_id = 2 WHERE rule_id = 1
RETURNING rule_id, instrument_id;
 rule_id | instrument_id 
---------+---------------
       1 |             2
(1 row)

SELECT * FROM mismatched_events ORDER BY event_id;
 event_id | rule_id | rule_instrument | tick_id | tick_instrument 
----------+---------+-----------------+---------+-----------------
        1 |       1 |               2 |       6 |               1
        7 |       1 |               2 |      27 |               1
(2 rows)

ROLLBACK TO SAVEPOINT start;
===== 3. Through the PARENT price_ticks: UPDATE of instrument_id is accepted =====
UPDATE price_ticks SET instrument_id = 2 WHERE tick_id = 6
RETURNING tick_id, instrument_id;
 tick_id | instrument_id 
---------+---------------
       6 |             2
(1 row)

SELECT * FROM mismatched_events ORDER BY event_id;
 event_id | rule_id | rule_instrument | tick_id | tick_instrument 
----------+---------+-----------------+---------+-----------------
        1 |       1 |               1 |       6 |               2
(1 row)

ROLLBACK;
===== After ROLLBACK (expect 0) =====
SELECT count(*) AS mismatched
FROM alert_events e
JOIN alert_rules r ON r.rule_id = e.rule_id
JOIN price_ticks t ON t.tick_id = e.tick_id
WHERE r.instrument_id <> t.instrument_id;
 mismatched 
------------
          0
(1 row)

