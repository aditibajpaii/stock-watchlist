 review2 | v_instrument_activity | view | r2_owner=arwdDxtm/r2_owner+|                         | 
         |                       |      | r2_analyst=r/r2_owner      |                         | 
 review2 | v_watchlist_contents  | view | (null)                     |                         | 
(3 rows)

===== 9. Least privilege, tested by switching identity with SET ROLE =====
SELECT max(observed_at) + interval '1 minute' AS t_feed
FROM price_ticks WHERE instrument_id = 6 
BEGIN;
--- r2_analyst ---
SET ROLE r2_analyst;
SELECT current_user;
 current_user 
--------------
 r2_analyst
(1 row)

allowed: aggregated view and market data
SELECT symbol, ticks, alerts, active_rules FROM review2.v_instrument_activity ORDER BY symbol;
  symbol  | ticks | alerts | active_rules 
----------+-------+--------+--------------
 BTCUSDT  |     8 |      2 |            1
 ETHUSDT  |     2 |      1 |            1
 HDFCBANK |     0 |      0 |            0
 INFY     |     2 |      0 |            0
 M&M      |     0 |      0 |            0
 RELIANCE |    12 |      3 |            2
 TCS      |     6 |      2 |            1
(7 rows)

SELECT count(*) AS price_ticks_visible FROM price_ticks;
 price_ticks_visible 
---------------------
                  30
(1 row)

SAVEPOINT a;
>>> EXPECTED ERROR [42501] analyst may not read users (emails)
SELECT username, email FROM users;
psql:sql/review2/17_security.sql:137: ERROR:  permission denied for table users
<<< actual SQLSTATE: 42501
ROLLBACK TO SAVEPOINT a;
>>> EXPECTED ERROR [42501] analyst may not read alert rules
SELECT * FROM alert_rules;
psql:sql/review2/17_security.sql:141: ERROR:  permission denied for table alert_rules
<<< actual SQLSTATE: 42501
ROLLBACK TO SAVEPOINT a;
>>> EXPECTED ERROR [42501] analyst may not insert ticks
INSERT INTO price_ticks (instrument_id, observed_at, price, source, source_event_id)
VALUES (1, now(), 1, 'MANUAL', 'r2-analyst-1');
psql:sql/review2/17_security.sql:146: ERROR:  permission denied for table price_ticks
<<< actual SQLSTATE: 42501
ROLLBACK TO SAVEPOINT a;
>>> EXPECTED ERROR [42501] analyst may not call the support procedure
CALL review2.sp_set_rule_active(4, false);
psql:sql/review2/17_security.sql:150: ERROR:  permission denied for procedure sp_set_rule_active
<<< actual SQLSTATE: 42501
ROLLBACK TO SAVEPOINT a;
RESET ROLE;
--- r2_support ---
SET ROLE r2_support;
SELECT current_user;
 current_user 
--------------
 r2_support
(1 row)

allowed: read active rules through view V3 (rule 5 is inactive, so it is not visible)
SELECT rule_id, direction, threshold, cooldown_seconds FROM review2.v_active_alert_rules ORDER BY rule_id;
 rule_id | direction |    threshold    | cooldown_seconds 
---------+-----------+-----------------+------------------
       1 | ABOVE     |   3000.00000000 |              300
       2 | BELOW     |   2800.00000000 |              300
       3 | ABOVE     | 100000.00000000 |               60
       4 | BELOW     |   3500.00000000 |                0
       6 | BELOW     |   3000.00000000 |              120
(5 rows)

allowed: change a cooldown through V3
UPDATE review2.v_active_alert_rules SET cooldown_seconds = 45 WHERE rule_id = 4
RETURNING rule_id, cooldown_seconds;
 rule_id | cooldown_seconds 
---------+------------------
       4 |               45
(1 row)

allowed: switch a rule off through the SECURITY DEFINER procedure (INOUT returns the previous state)
CALL review2.sp_set_rule_active(3, false);
psql:sql/review2/17_security.sql:164: NOTICE:  rule 3: is_active t -> f
 p_previous 
------------
 t
(1 row)

