 source  | source_event_id |      price      
---------+-----------------+-----------------
 BINANCE | r2-feed-1       | 100500.00000000
(1 row)

ROLLBACK;
after ROLLBACK the demo changes are gone:
SELECT rule_id, cooldown_seconds, is_active FROM alert_rules WHERE rule_id IN (3, 4) ORDER BY rule_id;
 rule_id | cooldown_seconds | is_active 
---------+------------------+-----------
       3 |               60 | t
       4 |                0 | t
(2 rows)

===== 10. REVOKE with before / after evidence =====
before REVOKE:
                                 Access privileges
 Schema |    Name     | Type  |  Access privileges   | Column privileges | Policies 
--------+-------------+-------+----------------------+-------------------+----------
 public | price_ticks | table | aditi=arwdDxtm/aditi+|                   | 
        |             |       | r2_owner=ar/aditi   +|                   | 
        |             |       | r2_analyst=r/aditi   |                   | 
(1 row)

BEGIN;
SET ROLE r2_analyst;
SELECT count(*) AS ticks_visible_to_analyst FROM price_ticks;
 ticks_visible_to_analyst 
--------------------------
                       30
(1 row)

ROLLBACK;
REVOKE SELECT ON price_ticks FROM r2_analyst;
after REVOKE SELECT ON price_ticks FROM r2_analyst:
                                 Access privileges
 Schema |    Name     | Type  |  Access privileges   | Column privileges | Policies 
--------+-------------+-------+----------------------+-------------------+----------
 public | price_ticks | table | aditi=arwdDxtm/aditi+|                   | 
        |             |       | r2_owner=ar/aditi    |                   | 
(1 row)

BEGIN;
SET ROLE r2_analyst;
>>> EXPECTED ERROR [42501] the same query now fails
SELECT count(*) AS ticks_visible_to_analyst FROM price_ticks;
psql:sql/review2/17_security.sql:223: ERROR:  permission denied for table price_ticks
<<< actual SQLSTATE: 42501
ROLLBACK;
the aggregated view still works, because it reads price_ticks with its OWNER rights:
BEGIN;
SET ROLE r2_analyst;
SELECT symbol, ticks FROM review2.v_instrument_activity WHERE ticks > 0 ORDER BY symbol;
  symbol  | ticks 
----------+-------
 BTCUSDT  |     8
 ETHUSDT  |     2
 INFY     |     2
 RELIANCE |    12
 TCS      |     6
(5 rows)

ROLLBACK;
GRANT SELECT ON price_ticks TO r2_analyst;
restored: GRANT SELECT ON price_ticks TO r2_analyst
===== 11. Definer routines and their pinned search_path =====
SELECT p.oid::regprocedure AS routine, p.prosecdef AS security_definer,
       pg_get_userbyid(p.proowner) AS owner, p.proconfig AS settings
FROM pg_proc p
WHERE p.pronamespace = 'review2'::regnamespace AND p.prosecdef
ORDER BY 1;
                                     routine                                     | security_definer |  owner   |            settings             
---------------------------------------------------------------------------------+------------------+----------+---------------------------------
 review2.sp_set_rule_active(bigint,boolean,boolean)                              | t                | r2_owner | {"search_path=public, pg_temp"}
 review2.fn_feed_ingest(text,text,timestamp with time zone,numeric,numeric,text) | t                | r2_owner | {"search_path=public, pg_temp"}
(2 rows)

